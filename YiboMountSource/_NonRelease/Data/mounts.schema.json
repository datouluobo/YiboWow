{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "target", "mounts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "required": ["flavor", "gameVersion", "interface"],
      "properties": {
        "flavor": { "const": "MISTS_CLASSIC" },
        "gameVersion": { "const": "5.5.4" },
        "interface": { "const": 50504 }
      }
    },
    "mounts": { "type": "array", "minItems": 1 }
  }
}
